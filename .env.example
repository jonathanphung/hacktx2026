# Copy to .env and fill in. Never commit .env.
# Add every new env var here with a placeholder so the other agents know it exists.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PORT=8787
# For a separately hosted AI server, set this public URL (never an API key).
VITE_AI_ENDPOINT=/api/ai/tactics


